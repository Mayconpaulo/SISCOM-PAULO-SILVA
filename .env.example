# GEMINI_API_KEY: Required for Gemini AI API calls (used automatically if OPENAI_API_KEY is not set).
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# OPENAI_API_KEY (Optional): If configured, the server uses OpenAI for BI Smart Search first;
# otherwise it automatically falls back to Gemini.
OPENAI_API_KEY=""
OPENAI_MODEL="gpt-4o-mini"

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="MY_APP_URL"

# Web Push (notificações em segundo plano mesmo com o aplicativo fechado)
# Gere um par VAPID com: npx web-push generate-vapid-keys
VAPID_PUBLIC_KEY=""
VAPID_PRIVATE_KEY=""
VAPID_SUBJECT="mailto:siscom@1bimec.eb.mil.br"

# Segredo de autenticação para o agendador /api/push/cron (Vercel Cron / agendador externo)
CRON_SECRET=""

# Persistência serverless das inscrições de push na Vercel (Upstash Redis ou Vercel KV)
UPSTASH_REDIS_REST_URL=""
UPSTASH_REDIS_REST_TOKEN=""

# Opcional: sobrescreve a chave web pública do Firebase para validação de tokens no backend
FIREBASE_WEB_API_KEY=""

# Opcional: projeto Firebase secundário dedicado ao OAuth do Google Calendar/Drive (se vazio, usa firebase-applet-config.json)
VITE_GOOGLE_CALENDAR_FIREBASE_API_KEY=""
VITE_GOOGLE_CALENDAR_FIREBASE_PROJECT_ID=""
VITE_GOOGLE_CALENDAR_FIREBASE_APP_ID=""
VITE_GOOGLE_CALENDAR_FIREBASE_AUTH_DOMAIN=""
VITE_GOOGLE_CALENDAR_FIREBASE_STORAGE_BUCKET=""
VITE_GOOGLE_CALENDAR_FIREBASE_MESSAGING_SENDER_ID=""
