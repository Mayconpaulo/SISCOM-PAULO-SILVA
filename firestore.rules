rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Global Safety Net (Default-Deny)
    match /{document=**} {
      allow read, write: if false;
    }

    function isSignedIn() {
      return request.auth != null;
    }

    function isValidId(id) {
      return id is string && id.size() >= 1 && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function isValidOptionalId(id) {
      return id is string && (id == '' || isValidId(id));
    }

    function isValidUsernameId(id) {
      return id is string && id.size() >= 2 && id.size() <= 40 && id.matches('^[a-z0-9._-]+$');
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    function isBootstrappedAdmin() {
      return isSignedIn()
        && request.auth.token.email_verified == true
        && request.auth.token.email == 'mayconpaulo6000@gmail.com';
    }

    function isAdmin() {
      return isBootstrappedAdmin()
        || (
          isSignedIn()
          && exists(/databases/$(database)/documents/admins/$(request.auth.uid))
          && (!exists(/databases/$(database)/documents/users/$(request.auth.uid))
              || get(/databases/$(database)/documents/users/$(request.auth.uid)).data.active == true)
        );
    }

    function canManageExistingUser(targetUid) {
      return isBootstrappedAdmin()
        || (
          isAdmin()
          && existing().username != 'admin-google'
          && (
            targetUid == request.auth.uid
            || request.auth.uid in existing().adminUids
            || existing().createdBy == request.auth.uid
          )
        );
    }

    function canAccessOwnAlteracaoArchive(userId) {
      return isOwner(userId)
        && isValidId(userId)
        && (
          isBootstrappedAdmin()
          || (
            exists(/databases/$(database)/documents/users/$(userId))
            && get(/databases/$(database)/documents/users/$(userId)).data.active == true
            && (
              get(/databases/$(database)/documents/users/$(userId)).data.role == 'admin'
              || get(/databases/$(database)/documents/users/$(userId)).data.permAlteracao == true
            )
          )
        );
    }

    function canAccessOwnDemandas(userId) {
      return isOwner(userId)
        && isValidId(userId)
        && (
          isBootstrappedAdmin()
          || (
            exists(/databases/$(database)/documents/users/$(userId))
            && get(/databases/$(database)/documents/users/$(userId)).data.active == true
          )
        );
    }

    function canAccessOwnRelatorios(userId) {
      return isOwner(userId)
        && isValidId(userId)
        && (
          isBootstrappedAdmin()
          || (
            exists(/databases/$(database)/documents/users/$(userId))
            && get(/databases/$(database)/documents/users/$(userId)).data.active == true
            && (
              get(/databases/$(database)/documents/users/$(userId)).data.role == 'admin'
              || !('permRelatorio' in get(/databases/$(database)/documents/users/$(userId)).data)
              || get(/databases/$(database)/documents/users/$(userId)).data.permRelatorio == true
            )
          )
        );
    }

    function canAccessAgenda() {
      return isBootstrappedAdmin()
        || (
          isSignedIn()
          && exists(/databases/$(database)/documents/users/$(request.auth.uid))
          && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.active == true
          && (
            get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'admin'
            || get(/databases/$(database)/documents/users/$(request.auth.uid)).data.permAgenda == true
          )
        );
    }

    function isValidDriveId(id) {
      return id is string && id.size() >= 1 && id.size() <= 256 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function canAccessArquivo() {
      return isBootstrappedAdmin()
        || (
          isSignedIn()
          && exists(/databases/$(database)/documents/users/$(request.auth.uid))
          && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.active == true
          && (
            get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'admin'
            || get(/databases/$(database)/documents/users/$(request.auth.uid)).data.permArquivo == true
          )
        );
    }

    function canCreateActivityLog() {
      return isBootstrappedAdmin()
        || (
          isSignedIn()
          && exists(/databases/$(database)/documents/users/$(request.auth.uid))
          && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.active == true
        );
    }

    function isValidAdminMarker(data, targetUid) {
      return data.keys().hasAll(['uid', 'createdBy', 'createdAt'])
        && data.keys().hasOnly(['uid', 'createdBy', 'createdAt'])
        && isValidId(data.uid)
        && data.uid == targetUid
        && isValidId(data.createdBy)
        && data.createdAt is timestamp;
    }

    function isValidUserAccount(data, targetUid) {
      return data.keys().hasAll([
          'uid',
          'username',
          'displayName',
          'role',
          'active',
          'emailVerified',
          'permPrismas',
          'permCrachas',
          'permAlteracao',
          'permDocumentos',
          'permCartoes',
          'adminUids',
          'createdBy',
          'createdAt',
          'updatedAt'
        ])
        && data.keys().hasOnly([
          'uid',
          'username',
          'displayName',
          'role',
          'active',
          'emailVerified',
          'mustChangePassword',
          'securityQuestionSetup',
          'permPrismas',
          'permCrachas',
          'permAlteracao',
          'permDocumentos',
          'permCartoes',
          'permRelatorio',
          'permAgenda',
          'permArquivo',
          'permInstagram',
          'adminUids',
          'createdBy',
          'createdAt',
          'updatedAt'
        ])
        && isValidId(data.uid)
        && data.uid == targetUid
        && isValidUsernameId(data.username)
        && data.displayName is string
        && data.displayName.size() >= 1
        && data.displayName.size() <= 80
        && data.role in ['admin', 'user']
        && data.active is bool
        && data.emailVerified is bool
        && (!('mustChangePassword' in data) || data.mustChangePassword is bool)
        && (!('securityQuestionSetup' in data) || data.securityQuestionSetup is bool)
        && data.permPrismas is bool
        && data.permCrachas is bool
        && data.permAlteracao is bool
        && data.permDocumentos is bool
        && data.permCartoes is bool
        && (!('permRelatorio' in data) || data.permRelatorio is bool)
        && (!('permAgenda' in data) || data.permAgenda is bool)
        && (!('permArquivo' in data) || data.permArquivo is bool)
        && (!('permInstagram' in data) || data.permInstagram is bool)
        && data.adminUids is list
        && data.adminUids.size() >= 1
        && data.adminUids.size() <= 10
        && data.adminUids[0] is string
        && data.adminUids[0].size() >= 1
        && data.adminUids[0].size() <= 128
        && isValidId(data.createdBy)
        && data.createdAt is timestamp
        && data.updatedAt is timestamp;
    }

    function isValidRecoveryDoc(data, targetUsername) {
      return data.keys().hasAll([
          'uid',
          'username',
          'question',
          'salt',
          'iv',
          'encryptedPassword',
          'updatedAt'
        ])
        && data.keys().hasOnly([
          'uid',
          'username',
          'question',
          'salt',
          'iv',
          'encryptedPassword',
          'updatedAt'
        ])
        && isValidId(data.uid)
        && isValidUsernameId(data.username)
        && data.username == targetUsername
        && data.question is string
        && data.question.size() >= 3
        && data.question.size() <= 160
        && data.salt is string
        && data.salt.size() >= 12
        && data.salt.size() <= 64
        && data.iv is string
        && data.iv.size() >= 12
        && data.iv.size() <= 64
        && data.encryptedPassword is string
        && data.encryptedPassword.size() >= 16
        && data.encryptedPassword.size() <= 512
        && data.updatedAt is timestamp
        && data.updatedAt == request.time;
    }

    function isValidAuthLookupDoc(data, targetUsername) {
      return data.keys().hasAll(['uid', 'username', 'authEmail', 'updatedAt'])
        && data.keys().hasOnly(['uid', 'username', 'authEmail', 'updatedAt'])
        && isValidId(data.uid)
        && isValidUsernameId(data.username)
        && data.username == targetUsername
        && data.authEmail is string
        && data.authEmail.size() >= 6
        && data.authEmail.size() <= 120
        && data.authEmail.matches('^[a-z0-9._-]+@siscom\\.app$')
        && data.updatedAt is timestamp
        && data.updatedAt == request.time;
    }

    function isValidAlteracaoFolder(data, userId, folderId) {
      return data.keys().hasAll(['id', 'ownerUid', 'name', 'parentId', 'createdAt', 'updatedAt'])
        && data.keys().hasOnly(['id', 'ownerUid', 'name', 'parentId', 'createdAt', 'updatedAt'])
        && isValidId(data.id)
        && data.id == folderId
        && isValidId(data.ownerUid)
        && data.ownerUid == userId
        && data.name is string
        && data.name.size() >= 1
        && data.name.size() <= 80
        && isValidOptionalId(data.parentId)
        && data.parentId != folderId
        && data.createdAt is timestamp
        && data.updatedAt is timestamp;
    }

    function isValidAlteracaoHeaderMap(header) {
      return header is map
        && header.keys().hasAll([
          'ministerio',
          'forca',
          'comandoDivisao',
          'grandeUnidade',
          'omCodom',
          'omExtenso',
          'tituloDocumento',
          'guarnicao',
          'folhaInicial',
          'nomeCompleto',
          'nomeGuerra',
          'generoCont',
          'postoGraduacao',
          'qasQms',
          'identidade',
          'semestre',
          'periodo'
        ])
        && header.keys().hasOnly([
          'ministerio',
          'forca',
          'comandoDivisao',
          'grandeUnidade',
          'omCodom',
          'omExtenso',
          'tituloDocumento',
          'guarnicao',
          'folhaInicial',
          'nomeCompleto',
          'nomeGuerra',
          'generoCont',
          'postoGraduacao',
          'qasQms',
          'identidade',
          'semestre',
          'periodo'
        ])
        && header.ministerio is string && header.ministerio.size() <= 160
        && header.forca is string && header.forca.size() <= 160
        && header.comandoDivisao is string && header.comandoDivisao.size() <= 160
        && header.grandeUnidade is string && header.grandeUnidade.size() <= 160
        && header.omCodom is string && header.omCodom.size() <= 160
        && header.omExtenso is string && header.omExtenso.size() <= 200
        && header.tituloDocumento is string && header.tituloDocumento.size() <= 160
        && header.guarnicao is string && header.guarnicao.size() <= 160
        && header.folhaInicial is int && header.folhaInicial >= 1 && header.folhaInicial <= 9999
        && header.nomeCompleto is string && header.nomeCompleto.size() <= 180
        && header.nomeGuerra is string && header.nomeGuerra.size() <= 100
        && header.generoCont in ['auto', 'do', 'da']
        && header.postoGraduacao is string && header.postoGraduacao.size() <= 100
        && header.qasQms is string && header.qasQms.size() <= 100
        && header.identidade is string && header.identidade.size() <= 80
        && header.semestre is string && header.semestre.size() <= 120
        && header.periodo is string && header.periodo.size() <= 160;
    }

    function isValidDemandaItem(data, userId, demandaId) {
      return data.keys().hasAll([
          'id',
          'ownerUid',
          'title',
          'notes',
          'dueDate',
          'dueTime',
          'priority',
          'status',
          'remindBeforeDays',
          'completedAt',
          'createdAt',
          'updatedAt'
        ])
        && data.keys().hasOnly([
          'id',
          'ownerUid',
          'title',
          'notes',
          'dueDate',
          'dueTime',
          'priority',
          'status',
          'remindBeforeDays',
          'completedAt',
          'createdAt',
          'updatedAt'
        ])
        && isValidId(data.id)
        && data.id == demandaId
        && isValidId(data.ownerUid)
        && data.ownerUid == userId
        && data.title is string && data.title.size() >= 1 && data.title.size() <= 160
        && data.notes is string && data.notes.size() <= 1000
        && data.dueDate is string && data.dueDate.size() == 10 && data.dueDate.matches('^\\d{4}-\\d{2}-\\d{2}$')
        && data.dueTime is string && (data.dueTime.size() == 0 || (data.dueTime.size() == 5 && data.dueTime.matches('^\\d{2}:\\d{2}$')))
        && data.priority in ['baixa', 'media', 'alta']
        && data.status in ['pendente', 'concluida']
        && data.remindBeforeDays is int && data.remindBeforeDays >= 0 && data.remindBeforeDays <= 30
        && data.completedAt is string && data.completedAt.size() <= 40
        && data.createdAt is timestamp
        && data.updatedAt is timestamp;
    }

    function isValidRelatorioVtrMap(vtr) {
      return vtr is map
        && vtr.keys().hasAll([
          'om',
          'motocicletasExistente',
          'motocicletasDisponivel',
          'vtrOpExistente',
          'vtrOpDisponivel',
          'vtrAdmExistente',
          'vtrAdmDisponivel',
          'vtrBldExistente',
          'vtrBldDisponivel',
          'obusMrtExistente',
          'obusMrtDisponivel'
        ])
        && vtr.keys().hasOnly([
          'om',
          'motocicletasExistente',
          'motocicletasDisponivel',
          'vtrOpExistente',
          'vtrOpDisponivel',
          'vtrAdmExistente',
          'vtrAdmDisponivel',
          'vtrBldExistente',
          'vtrBldDisponivel',
          'obusMrtExistente',
          'obusMrtDisponivel'
        ])
        && vtr.om is string && vtr.om.size() <= 60
        && vtr.motocicletasExistente is string && vtr.motocicletasExistente.size() <= 24
        && vtr.motocicletasDisponivel is string && vtr.motocicletasDisponivel.size() <= 24
        && vtr.vtrOpExistente is string && vtr.vtrOpExistente.size() <= 24
        && vtr.vtrOpDisponivel is string && vtr.vtrOpDisponivel.size() <= 24
        && vtr.vtrAdmExistente is string && vtr.vtrAdmExistente.size() <= 24
        && vtr.vtrAdmDisponivel is string && vtr.vtrAdmDisponivel.size() <= 24
        && vtr.vtrBldExistente is string && vtr.vtrBldExistente.size() <= 24
        && vtr.vtrBldDisponivel is string && vtr.vtrBldDisponivel.size() <= 24
        && vtr.obusMrtExistente is string && vtr.obusMrtExistente.size() <= 24
        && vtr.obusMrtDisponivel is string && vtr.obusMrtDisponivel.size() <= 24;
    }

    function isValidRelatorioDoc(data, userId, relatorioId) {
      return data.keys().hasAll([
          'id',
          'ownerUid',
          'title',
          'periodoCabecalho',
          'preparoEmprego',
          'estadoSanitario',
          'problemasDisciplinares',
          'generosAlimenticios',
          'vtrDisponibilidade',
          'marcaModeloRows',
          'execucaoFinanceiraRows',
          'diversosEventos',
          'clientUpdatedAt',
          'createdAt',
          'updatedAt'
        ])
        && data.keys().hasOnly([
          'id',
          'ownerUid',
          'title',
          'periodoCabecalho',
          'preparoEmprego',
          'estadoSanitario',
          'problemasDisciplinares',
          'generosAlimenticios',
          'vtrDisponibilidade',
          'marcaModeloRows',
          'execucaoFinanceiraRows',
          'diversosEventos',
          'clientUpdatedAt',
          'createdAt',
          'updatedAt'
        ])
        && isValidId(data.id)
        && data.id == relatorioId
        && isValidId(data.ownerUid)
        && data.ownerUid == userId
        && data.title is string && data.title.size() >= 1 && data.title.size() <= 160
        && data.periodoCabecalho is string && data.periodoCabecalho.size() <= 120
        && data.preparoEmprego is string && data.preparoEmprego.size() <= 400
        && data.estadoSanitario is string && data.estadoSanitario.size() <= 400
        && data.problemasDisciplinares is string && data.problemasDisciplinares.size() <= 400
        && data.generosAlimenticios is string && data.generosAlimenticios.size() <= 400
        && isValidRelatorioVtrMap(data.vtrDisponibilidade)
        && data.marcaModeloRows is list
        && data.marcaModeloRows.size() <= 40
        && (data.marcaModeloRows.size() == 0 || data.marcaModeloRows[0] is map)
        && data.execucaoFinanceiraRows is list
        && data.execucaoFinanceiraRows.size() <= 40
        && (data.execucaoFinanceiraRows.size() == 0 || data.execucaoFinanceiraRows[0] is map)
        && data.diversosEventos is list
        && data.diversosEventos.size() <= 200
        && (data.diversosEventos.size() == 0 || data.diversosEventos[0] is map)
        && data.clientUpdatedAt is string && data.clientUpdatedAt.size() <= 40
        && data.createdAt is timestamp
        && data.updatedAt is timestamp;
    }

    function isValidAlteracaoDoc(data, userId, docId) {
      return data.keys().hasAll([
          'id',
          'ownerUid',
          'folderId',
          'title',
          'header',
          'pagesHtml',
          'fontFamily',
          'fontSizePt',
          'lineHeight',
          'dataPraca',
          'dataFinal',
          'enabledItemIds',
          'structuredDocJson',
          'createdAt',
          'updatedAt'
        ])
        && data.keys().hasOnly([
          'id',
          'ownerUid',
          'folderId',
          'title',
          'header',
          'pagesHtml',
          'fontFamily',
          'fontSizePt',
          'lineHeight',
          'dataPraca',
          'dataFinal',
          'enabledItemIds',
          'structuredDocJson',
          'createdAt',
          'updatedAt'
        ])
        && isValidId(data.id)
        && data.id == docId
        && isValidId(data.ownerUid)
        && data.ownerUid == userId
        && isValidOptionalId(data.folderId)
        && data.title is string
        && data.title.size() >= 1
        && data.title.size() <= 160
        && isValidAlteracaoHeaderMap(data.header)
        && data.pagesHtml is list
        && data.pagesHtml.size() >= 1
        && data.pagesHtml.size() <= 60
        && data.pagesHtml[0] is string
        && data.pagesHtml[0].size() <= 200000
        && data.fontFamily is string
        && data.fontFamily.size() >= 1
        && data.fontFamily.size() <= 40
        && data.fontSizePt is string
        && data.fontSizePt.size() >= 1
        && data.fontSizePt.size() <= 12
        && data.lineHeight is string
        && data.lineHeight.size() >= 1
        && data.lineHeight.size() <= 12
        && data.dataPraca is string
        && data.dataPraca.size() <= 20
        && data.dataFinal is string
        && data.dataFinal.size() <= 20
        && data.enabledItemIds is list
        && data.enabledItemIds.size() <= 500
        && data.structuredDocJson is string
        && data.structuredDocJson.size() <= 260000
        && data.createdAt is timestamp
        && data.updatedAt is timestamp;
    }

    function isValidAgendaEvent(data, eventId) {
      return data.keys().hasAll([
          'id',
          'title',
          'category',
          'status',
          'startAt',
          'endAt',
          'allDay',
          'location',
          'responsibles',
          'description',
          'reminderMinutes',
          'sectionScope',
          'googleEventId',
          'googleCalendarId',
          'googleCalendarSummary',
          'googleHtmlLink',
          'syncStatus',
          'lastSyncedAt',
          'createdByUid',
          'createdByName',
          'updatedByUid',
          'updatedByName',
          'createdAt',
          'updatedAt'
        ])
        && data.keys().hasOnly([
          'id',
          'title',
          'category',
          'status',
          'startAt',
          'endAt',
          'allDay',
          'location',
          'responsibles',
          'description',
          'reminderMinutes',
          'sectionScope',
          'googleEventId',
          'googleCalendarId',
          'googleCalendarSummary',
          'googleHtmlLink',
          'syncStatus',
          'lastSyncedAt',
          'comsocScope',
          'colorId',
          'recurrenceRule',
          'visibility',
          'transparency',
          'meetLink',
          'createMeet',
          'attendeesJson',
          'guestsCanModify',
          'guestsCanInviteOthers',
          'guestsCanSeeOtherGuests',
          'sendUpdates',
          'attachmentsJson',
          'remindersJson',
          'pendingGoogleSync',
          'createdByUid',
          'createdByName',
          'updatedByUid',
          'updatedByName',
          'createdAt',
          'updatedAt'
        ])
        && isValidId(data.id)
        && data.id == eventId
        && data.title is string
        && data.title.size() >= 1
        && data.title.size() <= 140
        && data.category in [
          'solenidade',
          'formatura',
          'visita',
          'fotografia',
          'audiovisual',
          'reuniao',
          'data_comemorativa',
          'outros'
        ]
        && data.status in ['agendado', 'realizado', 'cancelado']
        && data.startAt is string
        && data.startAt.size() >= 10
        && data.startAt.size() <= 40
        && data.endAt is string
        && data.endAt.size() >= 10
        && data.endAt.size() <= 40
        && data.allDay is bool
        && data.location is string
        && data.location.size() <= 180
        && data.responsibles is string
        && data.responsibles.size() <= 240
        && data.description is string
        && data.description.size() <= 2000
        && data.reminderMinutes is int
        && data.reminderMinutes >= 0
        && data.reminderMinutes <= 10080
        && data.sectionScope == 'comsoc'
        && data.googleEventId is string
        && data.googleEventId.size() <= 256
        && data.googleCalendarId is string
        && data.googleCalendarId.size() <= 256
        && data.googleCalendarSummary is string
        && data.googleCalendarSummary.size() <= 140
        && data.googleHtmlLink is string
        && data.googleHtmlLink.size() <= 400
        && data.syncStatus in ['internal', 'synced', 'error']
        && data.lastSyncedAt is string
        && data.lastSyncedAt.size() <= 40
        && (!('comsocScope' in data) || data.comsocScope in ['comsoc', 'general', 'pending'])
        && (!('colorId' in data) || (data.colorId is string && data.colorId.size() <= 16))
        && (!('recurrenceRule' in data) || (data.recurrenceRule is string && data.recurrenceRule.size() <= 200))
        && (!('visibility' in data) || data.visibility in ['default', 'public', 'private'])
        && (!('transparency' in data) || data.transparency in ['opaque', 'transparent'])
        && (!('meetLink' in data) || (data.meetLink is string && data.meetLink.size() <= 400))
        && (!('createMeet' in data) || data.createMeet is bool)
        && (!('attendeesJson' in data) || (data.attendeesJson is string && data.attendeesJson.size() <= 12000))
        && (!('guestsCanModify' in data) || data.guestsCanModify is bool)
        && (!('guestsCanInviteOthers' in data) || data.guestsCanInviteOthers is bool)
        && (!('guestsCanSeeOtherGuests' in data) || data.guestsCanSeeOtherGuests is bool)
        && (!('sendUpdates' in data) || data.sendUpdates in ['all', 'none'])
        && (!('attachmentsJson' in data) || (data.attachmentsJson is string && data.attachmentsJson.size() <= 12000))
        && (!('remindersJson' in data) || (data.remindersJson is string && data.remindersJson.size() <= 2000))
        && (!('pendingGoogleSync' in data) || data.pendingGoogleSync is bool)
        && isValidId(data.createdByUid)
        && data.createdByName is string
        && data.createdByName.size() >= 1
        && data.createdByName.size() <= 80
        && isValidId(data.updatedByUid)
        && data.updatedByName is string
        && data.updatedByName.size() >= 1
        && data.updatedByName.size() <= 80
        && data.createdAt is timestamp
        && data.updatedAt is timestamp;
    }

    function isValidAgendaAuditLog(data, logId) {
      return data.keys().hasAll([
          'id',
          'eventId',
          'action',
          'summary',
          'actorUid',
          'actorName',
          'sectionScope',
          'createdAt'
        ])
        && data.keys().hasOnly([
          'id',
          'eventId',
          'action',
          'summary',
          'actorUid',
          'actorName',
          'sectionScope',
          'createdAt'
        ])
        && isValidId(data.id)
        && data.id == logId
        && isValidOptionalId(data.eventId)
        && data.action in [
          'create',
          'update',
          'delete',
          'sync_push',
          'sync_update',
          'sync_delete',
          'google_connect',
          'google_disconnect'
        ]
        && data.summary is string
        && data.summary.size() >= 1
        && data.summary.size() <= 240
        && isValidId(data.actorUid)
        && data.actorName is string
        && data.actorName.size() >= 1
        && data.actorName.size() <= 80
        && data.sectionScope == 'comsoc'
        && data.createdAt is timestamp;
    }

    function isValidAgendaConfig(data, configId) {
      return data.keys().hasAll([
          'id',
          'selectedCalendarId',
          'selectedCalendarSummary',
          'updatedByUid',
          'updatedByName',
          'updatedAt'
        ])
        && data.keys().hasOnly([
          'id',
          'selectedCalendarId',
          'selectedCalendarSummary',
          'lockedAccountEmail',
          'lastSyncAt',
          'contactsCacheJson',
          'updatedByUid',
          'updatedByName',
          'updatedAt'
        ])
        && data.id == 'google_calendar'
        && configId == 'google_calendar'
        && data.selectedCalendarId is string
        && data.selectedCalendarId.size() <= 256
        && data.selectedCalendarSummary is string
        && data.selectedCalendarSummary.size() <= 140
        && (!('lockedAccountEmail' in data) || (data.lockedAccountEmail is string && data.lockedAccountEmail.size() <= 140))
        && (!('lastSyncAt' in data) || (data.lastSyncAt is string && data.lastSyncAt.size() <= 40))
        && (!('contactsCacheJson' in data) || (data.contactsCacheJson is string && data.contactsCacheJson.size() <= 60000))
        && isValidId(data.updatedByUid)
        && data.updatedByName is string
        && data.updatedByName.size() >= 1
        && data.updatedByName.size() <= 80
        && data.updatedAt is timestamp;
    }

    function isValidDriveConfig(data, configId) {
      return data.keys().hasAll([
          'id',
          'rootFolderId',
          'rootFolderName',
          'institutionalEmail',
          'linkedAccountEmail',
          'driveWebViewUrl',
          'sectionScope',
          'updatedByUid',
          'updatedByName',
          'updatedAt'
        ])
        && data.keys().hasOnly([
          'id',
          'rootFolderId',
          'rootFolderName',
          'institutionalEmail',
          'linkedAccountEmail',
          'driveWebViewUrl',
          'sectionScope',
          'updatedByUid',
          'updatedByName',
          'updatedAt'
        ])
        && data.id == 'root_folder'
        && configId == 'root_folder'
        && isValidDriveId(data.rootFolderId)
        && data.rootFolderName is string
        && data.rootFolderName.size() >= 1
        && data.rootFolderName.size() <= 140
        && data.institutionalEmail is string
        && data.institutionalEmail.size() <= 140
        && data.linkedAccountEmail is string
        && data.linkedAccountEmail.size() <= 140
        && data.driveWebViewUrl is string
        && data.driveWebViewUrl.size() <= 400
        && data.sectionScope == 'comsoc'
        && isValidId(data.updatedByUid)
        && data.updatedByName is string
        && data.updatedByName.size() >= 1
        && data.updatedByName.size() <= 80
        && data.updatedAt is timestamp;
    }

    function isValidDriveAuditLog(data, logId) {
      return data.keys().hasAll([
          'id',
          'action',
          'targetId',
          'targetName',
          'summary',
          'actorUid',
          'actorName',
          'sectionScope',
          'createdAt'
        ])
        && data.keys().hasOnly([
          'id',
          'action',
          'targetId',
          'targetName',
          'summary',
          'actorUid',
          'actorName',
          'sectionScope',
          'createdAt'
        ])
        && isValidId(data.id)
        && data.id == logId
        && data.action in [
          'drive_connect',
          'drive_disconnect',
          'root_select',
          'root_unlink',
          'folder_create',
          'folder_rename',
          'folder_delete',
          'file_upload'
        ]
        && data.targetId is string
        && data.targetId.size() <= 256
        && data.targetName is string
        && data.targetName.size() <= 240
        && data.summary is string
        && data.summary.size() >= 1
        && data.summary.size() <= 240
        && isValidId(data.actorUid)
        && data.actorName is string
        && data.actorName.size() >= 1
        && data.actorName.size() <= 80
        && data.sectionScope == 'comsoc'
        && data.createdAt is timestamp;
    }

    function isValidActivityLog(data, logId) {
      return data.keys().hasAll([
          'id',
          'actorUid',
          'actorUsername',
          'actorDisplayName',
          'actorRole',
          'module',
          'action',
          'summary',
          'detail',
          'sectionScope',
          'createdAt'
        ])
        && data.keys().hasOnly([
          'id',
          'actorUid',
          'actorUsername',
          'actorDisplayName',
          'actorRole',
          'module',
          'action',
          'summary',
          'detail',
          'sectionScope',
          'createdAt'
        ])
        && isValidId(data.id)
        && data.id == logId
        && isValidId(data.actorUid)
        && data.actorUsername is string
        && data.actorUsername.size() >= 1
        && data.actorUsername.size() <= 60
        && data.actorDisplayName is string
        && data.actorDisplayName.size() >= 1
        && data.actorDisplayName.size() <= 80
        && data.actorRole in ['admin', 'user']
        && data.module in [
          'auth',
          'admin',
          'prismas',
          'crachas',
          'alteracao',
          'documentos',
          'cartoes',
          'relatorio',
          'agenda',
          'arquivo',
          'demandas',
          'sistema'
        ]
        && data.action is string
        && data.action.size() >= 1
        && data.action.size() <= 60
        && data.action.matches('^[a-z0-9_]+$')
        && data.summary is string
        && data.summary.size() >= 1
        && data.summary.size() <= 240
        && data.detail is string
        && data.detail.size() <= 300
        && data.sectionScope == 'siscom'
        && data.createdAt is timestamp;
    }

    match /admins/{userId} {
      allow get: if isSignedIn() && isValidId(userId) && (isOwner(userId) || isAdmin());
      allow list: if false;
      allow create: if isAdmin()
        && isValidId(userId)
        && isValidAdminMarker(incoming(), userId)
        && incoming().createdBy == request.auth.uid
        && incoming().createdAt == request.time;
      allow update: if false;
      allow delete: if isAdmin()
        && isValidId(userId)
        && userId != request.auth.uid
        && (
          isBootstrappedAdmin()
          || (
            exists(/databases/$(database)/documents/users/$(userId))
            && get(/databases/$(database)/documents/users/$(userId)).data.username != 'admin-google'
            && (
              request.auth.uid in get(/databases/$(database)/documents/users/$(userId)).data.adminUids
              || get(/databases/$(database)/documents/users/$(userId)).data.createdBy == request.auth.uid
            )
          )
        );
    }

    match /users/{userId} {
      allow get: if isSignedIn() && isValidId(userId) && (isOwner(userId) || isAdmin());
      allow list: if isSignedIn() && (
        isBootstrappedAdmin()
        || request.auth.uid in resource.data.adminUids
        || resource.data.uid == request.auth.uid
      );
      allow create: if isAdmin()
        && isValidId(userId)
        && isValidUserAccount(incoming(), userId)
        && incoming().createdBy == request.auth.uid
        && incoming().createdAt == request.time
        && incoming().updatedAt == request.time;
      allow update: if isSignedIn()
        && isValidId(userId)
        && isValidUserAccount(incoming(), userId)
        && incoming().uid == existing().uid
        && incoming().createdBy == existing().createdBy
        && incoming().createdAt == existing().createdAt
        && incoming().updatedAt == request.time
        && (
          (canManageExistingUser(userId) && (
            incoming().diff(existing()).affectedKeys().hasOnly([
              'permPrismas',
              'permCrachas',
              'permAlteracao',
              'permDocumentos',
              'permCartoes',
              'permRelatorio',
              'permAgenda',
              'permArquivo',
              'updatedAt'
            ])
            || incoming().diff(existing()).affectedKeys().hasOnly([
              'username',
              'displayName',
              'role',
              'active',
              'emailVerified',
              'mustChangePassword',
              'securityQuestionSetup',
              'adminUids',
              'permPrismas',
              'permCrachas',
              'permAlteracao',
              'permDocumentos',
              'permCartoes',
              'permRelatorio',
              'permAgenda',
              'permArquivo',
              'updatedAt'
            ])
          ))
          || (
            isOwner(userId)
            && existing().active == true
            && (!('mustChangePassword' in incoming()) || incoming().mustChangePassword == false)
            && incoming().diff(existing()).affectedKeys().hasOnly([
              'mustChangePassword',
              'securityQuestionSetup',
              'updatedAt'
            ])
          )
        );
      allow delete: if isValidId(userId)
        && userId != request.auth.uid
        && canManageExistingUser(userId);

      match /alteracao_folders/{folderId} {
        allow get: if canAccessOwnAlteracaoArchive(userId) && isValidId(folderId);
        allow list: if isOwner(userId)
          && isValidId(userId)
          && resource.data.ownerUid == request.auth.uid;
        allow create: if canAccessOwnAlteracaoArchive(userId)
          && isValidId(folderId)
          && isValidAlteracaoFolder(incoming(), userId, folderId)
          && incoming().createdAt == request.time
          && incoming().updatedAt == request.time;
        allow update: if canAccessOwnAlteracaoArchive(userId)
          && isValidId(folderId)
          && isValidAlteracaoFolder(incoming(), userId, folderId)
          && incoming().id == existing().id
          && incoming().ownerUid == existing().ownerUid
          && incoming().createdAt == existing().createdAt
          && incoming().updatedAt == request.time
          && incoming().diff(existing()).affectedKeys().hasOnly(['name', 'parentId', 'updatedAt']);
        allow delete: if canAccessOwnAlteracaoArchive(userId) && isValidId(folderId);
      }

      match /alteracao_docs/{docId} {
        allow get: if canAccessOwnAlteracaoArchive(userId) && isValidId(docId);
        allow list: if isOwner(userId)
          && isValidId(userId)
          && resource.data.ownerUid == request.auth.uid;
        allow create: if canAccessOwnAlteracaoArchive(userId)
          && isValidId(docId)
          && isValidAlteracaoDoc(incoming(), userId, docId)
          && incoming().createdAt == request.time
          && incoming().updatedAt == request.time;
        allow update: if canAccessOwnAlteracaoArchive(userId)
          && isValidId(docId)
          && isValidAlteracaoDoc(incoming(), userId, docId)
          && incoming().id == existing().id
          && incoming().ownerUid == existing().ownerUid
          && incoming().createdAt == existing().createdAt
          && incoming().updatedAt == request.time
          && incoming().diff(existing()).affectedKeys().hasOnly([
            'folderId',
            'title',
            'header',
            'pagesHtml',
            'fontFamily',
            'fontSizePt',
            'lineHeight',
            'dataPraca',
            'dataFinal',
            'enabledItemIds',
            'structuredDocJson',
            'updatedAt'
          ]);
        allow delete: if canAccessOwnAlteracaoArchive(userId) && isValidId(docId);
      }

      match /demandas/{demandaId} {
        allow get: if canAccessOwnDemandas(userId) && isValidId(demandaId);
        allow list: if isOwner(userId)
          && isValidId(userId)
          && resource.data.ownerUid == request.auth.uid;
        allow create: if canAccessOwnDemandas(userId)
          && isValidId(demandaId)
          && isValidDemandaItem(incoming(), userId, demandaId)
          && incoming().createdAt == request.time
          && incoming().updatedAt == request.time;
        allow update: if canAccessOwnDemandas(userId)
          && isValidId(demandaId)
          && isValidDemandaItem(incoming(), userId, demandaId)
          && incoming().id == existing().id
          && incoming().ownerUid == existing().ownerUid
          && incoming().createdAt == existing().createdAt
          && incoming().updatedAt == request.time
          && incoming().diff(existing()).affectedKeys().hasOnly([
            'title',
            'notes',
            'dueDate',
            'dueTime',
            'priority',
            'status',
            'remindBeforeDays',
            'completedAt',
            'updatedAt'
          ]);
        allow delete: if canAccessOwnDemandas(userId) && isValidId(demandaId);
      }

      match /relatorios/{relatorioId} {
        allow get: if canAccessOwnRelatorios(userId) && isValidId(relatorioId);
        allow list: if isOwner(userId)
          && isValidId(userId)
          && resource.data.ownerUid == request.auth.uid;
        allow create: if isOwner(userId)
          && isValidId(userId)
          && isValidId(relatorioId)
          && isValidRelatorioDoc(incoming(), userId, relatorioId)
          && incoming().createdAt == request.time
          && incoming().updatedAt == request.time
          && canAccessOwnRelatorios(userId);
        allow update: if isOwner(userId)
          && isValidId(userId)
          && isValidId(relatorioId)
          && isValidRelatorioDoc(incoming(), userId, relatorioId)
          && incoming().id == existing().id
          && incoming().ownerUid == existing().ownerUid
          && incoming().createdAt == existing().createdAt
          && incoming().updatedAt == request.time
          && incoming().diff(existing()).affectedKeys().hasOnly([
            'title',
            'periodoCabecalho',
            'preparoEmprego',
            'estadoSanitario',
            'problemasDisciplinares',
            'generosAlimenticios',
            'vtrDisponibilidade',
            'marcaModeloRows',
            'execucaoFinanceiraRows',
            'diversosEventos',
            'clientUpdatedAt',
            'updatedAt'
          ])
          && canAccessOwnRelatorios(userId);
        allow delete: if canAccessOwnRelatorios(userId) && isValidId(relatorioId);
      }
    }

    match /agenda_events/{eventId} {
      allow get: if canAccessAgenda() && isValidId(eventId);
      allow list: if isSignedIn() && resource.data.sectionScope == 'comsoc';
      allow create: if canAccessAgenda()
        && isValidId(eventId)
        && isValidAgendaEvent(incoming(), eventId)
        && incoming().createdByUid == request.auth.uid
        && incoming().updatedByUid == request.auth.uid
        && incoming().createdAt == request.time
        && incoming().updatedAt == request.time;
      allow update: if canAccessAgenda()
        && isValidId(eventId)
        && isValidAgendaEvent(incoming(), eventId)
        && incoming().id == existing().id
        && incoming().sectionScope == existing().sectionScope
        && incoming().createdByUid == existing().createdByUid
        && incoming().createdByName == existing().createdByName
        && incoming().createdAt == existing().createdAt
        && incoming().updatedByUid == request.auth.uid
        && incoming().updatedAt == request.time
        && incoming().diff(existing()).affectedKeys().hasOnly([
          'title',
          'category',
          'status',
          'startAt',
          'endAt',
          'allDay',
          'location',
          'responsibles',
          'description',
          'reminderMinutes',
          'googleEventId',
          'googleCalendarId',
          'googleCalendarSummary',
          'googleHtmlLink',
          'syncStatus',
          'lastSyncedAt',
          'comsocScope',
          'colorId',
          'recurrenceRule',
          'visibility',
          'transparency',
          'meetLink',
          'createMeet',
          'attendeesJson',
          'guestsCanModify',
          'guestsCanInviteOthers',
          'guestsCanSeeOtherGuests',
          'sendUpdates',
          'attachmentsJson',
          'remindersJson',
          'pendingGoogleSync',
          'updatedByUid',
          'updatedByName',
          'updatedAt'
        ]);
      allow delete: if canAccessAgenda() && isValidId(eventId);
    }

    match /agenda_audit/{logId} {
      allow get: if canAccessAgenda() && isValidId(logId);
      allow list: if isSignedIn() && resource.data.sectionScope == 'comsoc';
      allow create: if canAccessAgenda()
        && isValidId(logId)
        && isValidAgendaAuditLog(incoming(), logId)
        && incoming().actorUid == request.auth.uid
        && incoming().createdAt == request.time;
      allow update: if false;
      allow delete: if false;
    }

    match /agenda_config/{configId} {
      allow get: if canAccessAgenda() && configId == 'google_calendar';
      allow list: if false;
      allow create: if isAdmin()
        && configId == 'google_calendar'
        && isValidAgendaConfig(incoming(), configId)
        && incoming().updatedByUid == request.auth.uid
        && incoming().updatedAt == request.time;
      allow update: if isAdmin()
        && configId == 'google_calendar'
        && isValidAgendaConfig(incoming(), configId)
        && incoming().id == existing().id
        && incoming().updatedByUid == request.auth.uid
        && incoming().updatedAt == request.time
        && incoming().diff(existing()).affectedKeys().hasOnly([
          'selectedCalendarId',
          'selectedCalendarSummary',
          'lockedAccountEmail',
          'lastSyncAt',
          'contactsCacheJson',
          'updatedByUid',
          'updatedByName',
          'updatedAt'
        ]);
      allow delete: if false;
    }

    match /drive_config/{configId} {
      allow get: if canAccessArquivo() && configId == 'root_folder';
      allow list: if false;
      allow create: if isAdmin()
        && configId == 'root_folder'
        && isValidDriveConfig(incoming(), configId)
        && incoming().updatedByUid == request.auth.uid
        && incoming().updatedAt == request.time;
      allow update: if isAdmin()
        && configId == 'root_folder'
        && isValidDriveConfig(incoming(), configId)
        && incoming().id == existing().id
        && incoming().sectionScope == existing().sectionScope
        && incoming().updatedByUid == request.auth.uid
        && incoming().updatedAt == request.time
        && incoming().diff(existing()).affectedKeys().hasOnly([
          'rootFolderId',
          'rootFolderName',
          'institutionalEmail',
          'linkedAccountEmail',
          'driveWebViewUrl',
          'updatedByUid',
          'updatedByName',
          'updatedAt'
        ]);
      allow delete: if isAdmin() && configId == 'root_folder';
    }

    match /drive_audit/{logId} {
      allow get: if canAccessArquivo() && isValidId(logId);
      allow list: if isSignedIn() && resource.data.sectionScope == 'comsoc';
      allow create: if canAccessArquivo()
        && isValidId(logId)
        && isValidDriveAuditLog(incoming(), logId)
        && incoming().actorUid == request.auth.uid
        && incoming().createdAt == request.time;
      allow update: if false;
      allow delete: if false;
    }

    match /activity_logs/{logId} {
      allow get: if isAdmin() && isValidId(logId);
      allow list: if isAdmin() && resource.data.sectionScope == 'siscom';
      allow create: if isSignedIn()
        && isValidId(logId)
        && isValidActivityLog(incoming(), logId)
        && incoming().actorUid == request.auth.uid
        && incoming().createdAt == request.time
        && canCreateActivityLog();
      allow update: if false;
      allow delete: if false;
    }

    match /recovery/{username} {
      allow get: if isValidUsernameId(username);
      allow list: if false;
      allow create: if isSignedIn()
        && isValidUsernameId(username)
        && isValidRecoveryDoc(incoming(), username)
        && incoming().uid == request.auth.uid
        && exists(/databases/$(database)/documents/users/$(request.auth.uid))
        && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.username == username
        && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.active == true;
      allow update: if isSignedIn()
        && isValidUsernameId(username)
        && isValidRecoveryDoc(incoming(), username)
        && incoming().uid == existing().uid
        && incoming().username == existing().username
        && isOwner(existing().uid)
        && exists(/databases/$(database)/documents/users/$(request.auth.uid))
        && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.active == true;
      allow delete: if isSignedIn()
        && isValidUsernameId(username)
        && (isOwner(existing().uid) || isAdmin());
    }

    match /auth_lookup/{username} {
      allow get: if isValidUsernameId(username);
      allow list: if false;
      allow create: if isSignedIn()
        && isValidUsernameId(username)
        && isValidAuthLookupDoc(incoming(), username)
        && (
          isAdmin()
          || (
            incoming().uid == request.auth.uid
            && exists(/databases/$(database)/documents/users/$(request.auth.uid))
            && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.username == username
          )
        );
      allow update: if isSignedIn()
        && isValidUsernameId(username)
        && isValidAuthLookupDoc(incoming(), username)
        && (
          isAdmin()
          || (
            incoming().uid == existing().uid
            && isOwner(existing().uid)
          )
        );
      allow delete: if isSignedIn()
        && isValidUsernameId(username)
        && (isAdmin() || isOwner(existing().uid));
    }

    match /test/connection {
      allow get: if isSignedIn();
    }
  }
}
