{
  "entities": {
    "AdminMarker": {
      "title": "AdminMarker",
      "description": "Marcador de privilégio administrativo vinculado ao UID do Firebase Auth.",
      "type": "object",
      "properties": {
        "uid": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$",
          "description": "UID do usuário administrador"
        },
        "createdBy": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$",
          "description": "UID do administrador que concedeu o acesso"
        },
        "createdAt": {
          "type": "string",
          "format": "date-time",
          "description": "Data/hora de criação no servidor"
        }
      },
      "required": ["uid", "createdBy", "createdAt"]
    },
    "UserAccount": {
      "title": "UserAccount",
      "description": "Conta de acesso do SISCOM com permissões em tempo real por módulo e controle de primeiro acesso.",
      "type": "object",
      "properties": {
        "uid": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$",
          "description": "UID do usuário no Firebase Auth"
        },
        "username": {
          "type": "string",
          "minLength": 2,
          "maxLength": 40,
          "pattern": "^[a-z0-9._-]+$",
          "description": "Nome de usuário para login"
        },
        "displayName": {
          "type": "string",
          "minLength": 1,
          "maxLength": 80,
          "description": "Posto/graduação + nome de guerra de exibição"
        },
        "role": {
          "type": "string",
          "enum": ["admin", "user"],
          "description": "Perfil de acesso"
        },
        "active": {
          "type": "boolean",
          "description": "Indica se o login está ativo"
        },
        "emailVerified": {
          "type": "boolean",
          "description": "Compatibilidade legada de verificação"
        },
        "mustChangePassword": {
          "type": "boolean",
          "description": "Exige definição de nova senha no primeiro acesso"
        },
        "securityQuestionSetup": {
          "type": "boolean",
          "description": "Indica se a pergunta de segurança já foi configurada"
        },
        "permPrismas": {
          "type": "boolean",
          "description": "Acesso ao módulo Prismas"
        },
        "permCrachas": {
          "type": "boolean",
          "description": "Acesso ao módulo Crachás"
        },
        "permAlteracao": {
          "type": "boolean",
          "description": "Acesso ao módulo Alterações"
        },
        "permDocumentos": {
          "type": "boolean",
          "description": "Acesso ao módulo Documentos"
        },
        "permCartoes": {
          "type": "boolean",
          "description": "Acesso ao módulo Cartões"
        },
        "permRelatorio": {
          "type": "boolean",
          "description": "Acesso ao módulo Relatório"
        },
        "permAgenda": {
          "type": "boolean",
          "description": "Acesso ao módulo Agenda da Comunicação Social"
        },
        "adminUids": {
          "type": "array",
          "description": "Lista limitada (máx. 10) de UIDs de administradores gerenciadores"
        },
        "createdBy": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$",
          "description": "UID do administrador criador"
        },
        "createdAt": {
          "type": "string",
          "format": "date-time",
          "description": "Data/hora de criação no servidor"
        },
        "updatedAt": {
          "type": "string",
          "format": "date-time",
          "description": "Data/hora da última atualização no servidor"
        }
      },
      "required": [
        "uid",
        "username",
        "displayName",
        "role",
        "active",
        "emailVerified",
        "permPrismas",
        "permCrachas",
        "permAlteracao",
        "permDocumentos",
        "permCartoes",
        "adminUids",
        "createdBy",
        "createdAt",
        "updatedAt"
      ]
    },
    "RecoverySecret": {
      "title": "RecoverySecret",
      "description": "Pergunta de segurança e credencial cifrada com AES-GCM (derivada da resposta via PBKDF2) para redefinição de senha sem e-mail.",
      "type": "object",
      "properties": {
        "uid": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$",
          "description": "UID do usuário dono da pergunta"
        },
        "username": {
          "type": "string",
          "minLength": 2,
          "maxLength": 40,
          "pattern": "^[a-z0-9._-]+$",
          "description": "Nome de usuário associado"
        },
        "question": {
          "type": "string",
          "minLength": 3,
          "maxLength": 160,
          "description": "Pergunta de segurança definida pelo usuário"
        },
        "salt": {
          "type": "string",
          "minLength": 12,
          "maxLength": 64,
          "description": "Salt Base64 para derivação PBKDF2"
        },
        "iv": {
          "type": "string",
          "minLength": 12,
          "maxLength": 64,
          "description": "Vetor de inicialização Base64 para AES-GCM"
        },
        "encryptedPassword": {
          "type": "string",
          "minLength": 16,
          "maxLength": 512,
          "description": "Senha cifrada em Base64 usando AES-256-GCM"
        },
        "updatedAt": {
          "type": "string",
          "format": "date-time",
          "description": "Data/hora da última atualização no servidor"
        }
      },
      "required": [
        "uid",
        "username",
        "question",
        "salt",
        "iv",
        "encryptedPassword",
        "updatedAt"
      ]
    },
    "AuthLookup": {
      "title": "AuthLookup",
      "description": "Mapeamento interno não-PII entre nome de usuário e identificador de autenticação para permitir reutilização imediata de logins excluídos.",
      "type": "object",
      "properties": {
        "uid": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$",
          "description": "UID do usuário ativo"
        },
        "username": {
          "type": "string",
          "minLength": 2,
          "maxLength": 40,
          "pattern": "^[a-z0-9._-]+$",
          "description": "Nome de usuário normalizado"
        },
        "authEmail": {
          "type": "string",
          "minLength": 6,
          "maxLength": 120,
          "description": "Identificador sintético interno no Firebase Auth"
        },
        "updatedAt": {
          "type": "string",
          "format": "date-time",
          "description": "Data/hora da última atualização no servidor"
        }
      },
      "required": ["uid", "username", "authEmail", "updatedAt"]
    },
    "AlteracaoFolder": {
      "title": "AlteracaoFolder",
      "description": "Pasta ou subpasta pessoal da conta do usuário para organizar alterações editáveis.",
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$",
          "description": "Identificador único da pasta"
        },
        "ownerUid": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$",
          "description": "UID do proprietário da conta"
        },
        "name": {
          "type": "string",
          "minLength": 1,
          "maxLength": 80,
          "description": "Nome da pasta ou subpasta"
        },
        "parentId": {
          "type": "string",
          "minLength": 0,
          "maxLength": 128,
          "pattern": "^$|^[a-zA-Z0-9_\\-]+$",
          "description": "ID da pasta pai ou string vazia para pasta na raiz"
        },
        "createdAt": {
          "type": "string",
          "format": "date-time",
          "description": "Data/hora de criação no servidor"
        },
        "updatedAt": {
          "type": "string",
          "format": "date-time",
          "description": "Data/hora da última atualização no servidor"
        }
      },
      "required": ["id", "ownerUid", "name", "parentId", "createdAt", "updatedAt"]
    },
    "AlteracaoArchiveDoc": {
      "title": "AlteracaoArchiveDoc",
      "description": "Alteração editável arquivada na conta do usuário com páginas HTML, cabeçalho e estado estruturado.",
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$",
          "description": "Identificador único da alteração arquivada"
        },
        "ownerUid": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$",
          "description": "UID do proprietário da conta"
        },
        "folderId": {
          "type": "string",
          "minLength": 0,
          "maxLength": 128,
          "pattern": "^$|^[a-zA-Z0-9_\\-]+$",
          "description": "ID da pasta de destino ou string vazia para raiz"
        },
        "title": {
          "type": "string",
          "minLength": 1,
          "maxLength": 160,
          "description": "Título de identificação da alteração no arquivo"
        },
        "header": {
          "type": "object",
          "description": "Metadados completos do cabeçalho militar (AlteracaoHeaderData)"
        },
        "pagesHtml": {
          "type": "array",
          "description": "Lista ordenada do HTML editável de cada página A4 (1 a 60 páginas)"
        },
        "fontFamily": {
          "type": "string",
          "minLength": 1,
          "maxLength": 40,
          "description": "Família tipográfica aplicada no documento"
        },
        "fontSizePt": {
          "type": "string",
          "minLength": 1,
          "maxLength": 12,
          "description": "Tamanho da fonte em pontos"
        },
        "lineHeight": {
          "type": "string",
          "minLength": 1,
          "maxLength": 12,
          "description": "Espaçamento entre linhas"
        },
        "dataPraca": {
          "type": "string",
          "minLength": 0,
          "maxLength": 20,
          "description": "Data de praça para cálculo de tempo de serviço"
        },
        "dataFinal": {
          "type": "string",
          "minLength": 0,
          "maxLength": 20,
          "description": "Data final para cálculo de tempo de serviço"
        },
        "enabledItemIds": {
          "type": "array",
          "description": "Lista de IDs de tópicos e tabelas ativos no checklist"
        },
        "structuredDocJson": {
          "type": "string",
          "minLength": 0,
          "maxLength": 260000,
          "description": "Snapshot JSON opcional da estrutura de tópicos e tabelas para checklist"
        },
        "createdAt": {
          "type": "string",
          "format": "date-time",
          "description": "Data/hora de criação no servidor"
        },
        "updatedAt": {
          "type": "string",
          "format": "date-time",
          "description": "Data/hora da última atualização no servidor"
        }
      },
      "required": [
        "id",
        "ownerUid",
        "folderId",
        "title",
        "header",
        "pagesHtml",
        "fontFamily",
        "fontSizePt",
        "lineHeight",
        "dataPraca",
        "dataFinal",
        "enabledItemIds",
        "structuredDocJson",
        "createdAt",
        "updatedAt"
      ]
    },
    "AgendaEvent": {
      "title": "AgendaEvent",
      "description": "Atividade cadastrada na Agenda interna da Comunicação Social com suporte opcional à sincronização com calendário secundário do Google Calendar.",
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$",
          "description": "Identificador único da atividade no SISCOM"
        },
        "title": {
          "type": "string",
          "minLength": 1,
          "maxLength": 140,
          "description": "Título da atividade"
        },
        "category": {
          "type": "string",
          "enum": [
            "solenidade",
            "formatura",
            "visita",
            "fotografia",
            "audiovisual",
            "reuniao",
            "data_comemorativa",
            "outros"
          ],
          "description": "Categoria institucional da Comunicação Social"
        },
        "status": {
          "type": "string",
          "enum": ["agendado", "realizado", "cancelado"],
          "description": "Situação atual da atividade"
        },
        "startAt": {
          "type": "string",
          "minLength": 10,
          "maxLength": 40,
          "description": "Data/hora inicial em formato ISO"
        },
        "endAt": {
          "type": "string",
          "minLength": 10,
          "maxLength": 40,
          "description": "Data/hora final em formato ISO"
        },
        "allDay": {
          "type": "boolean",
          "description": "Indica se a atividade ocupa o dia inteiro"
        },
        "location": {
          "type": "string",
          "minLength": 0,
          "maxLength": 180,
          "description": "Local da atividade"
        },
        "responsibles": {
          "type": "string",
          "minLength": 0,
          "maxLength": 240,
          "description": "Militares ou equipe responsáveis pela atividade"
        },
        "description": {
          "type": "string",
          "minLength": 0,
          "maxLength": 2000,
          "description": "Descrição detalhada e observações da atividade"
        },
        "reminderMinutes": {
          "type": "integer",
          "minimum": 0,
          "maximum": 10080,
          "description": "Antecedência do lembrete em minutos (0 = desativado)"
        },
        "sectionScope": {
          "type": "string",
          "enum": ["comsoc"],
          "description": "Escopo institucional da seção"
        },
        "googleEventId": {
          "type": "string",
          "minLength": 0,
          "maxLength": 256,
          "description": "Identificador do evento vinculado no Google Calendar"
        },
        "googleCalendarId": {
          "type": "string",
          "minLength": 0,
          "maxLength": 256,
          "description": "ID do calendário secundário do Google Calendar vinculado"
        },
        "googleCalendarSummary": {
          "type": "string",
          "minLength": 0,
          "maxLength": 140,
          "description": "Nome do calendário secundário vinculado"
        },
        "googleHtmlLink": {
          "type": "string",
          "minLength": 0,
          "maxLength": 400,
          "description": "Link de visualização do evento no Google Calendar"
        },
        "syncStatus": {
          "type": "string",
          "enum": ["internal", "synced", "error"],
          "description": "Estado da sincronização com o Google Calendar"
        },
        "lastSyncedAt": {
          "type": "string",
          "minLength": 0,
          "maxLength": 40,
          "description": "Data/hora ISO da última sincronização bem-sucedida"
        },
        "comsocScope": {
          "type": "string",
          "enum": ["comsoc", "general", "pending"],
          "description": "Classificação da atividade: COMSOC, Geral (não-COMSOC) ou Pendente de triagem"
        },
        "colorId": {
          "type": "string",
          "minLength": 0,
          "maxLength": 16,
          "description": "ID da cor do evento no Google Calendar (1 a 11)"
        },
        "recurrenceRule": {
          "type": "string",
          "minLength": 0,
          "maxLength": 200,
          "description": "Regra RRULE de repetição compatível com o Google Calendar"
        },
        "visibility": {
          "type": "string",
          "enum": ["default", "public", "private"],
          "description": "Visibilidade do evento no Google Calendar"
        },
        "transparency": {
          "type": "string",
          "enum": ["opaque", "transparent"],
          "description": "Disponibilidade do evento (opaque = ocupado, transparent = disponível)"
        },
        "meetLink": {
          "type": "string",
          "minLength": 0,
          "maxLength": 400,
          "description": "Link da sala do Google Meet associada ao evento"
        },
        "createMeet": {
          "type": "boolean",
          "description": "Solicita criação automática de videoconferência do Google Meet ao sincronizar"
        },
        "attendeesJson": {
          "type": "string",
          "minLength": 0,
          "maxLength": 12000,
          "description": "JSON da lista de convidados (email, nome, opcional, status)"
        },
        "guestsCanModify": {
          "type": "boolean",
          "description": "Permite que convidados editem o evento no Google Calendar"
        },
        "guestsCanInviteOthers": {
          "type": "boolean",
          "description": "Permite que convidados convidem outras pessoas"
        },
        "guestsCanSeeOtherGuests": {
          "type": "boolean",
          "description": "Permite que convidados vejam a lista de convidados"
        },
        "sendUpdates": {
          "type": "string",
          "enum": ["all", "none"],
          "description": "Envia notificações por e-mail aos convidados no Google Calendar"
        },
        "attachmentsJson": {
          "type": "string",
          "minLength": 0,
          "maxLength": 12000,
          "description": "JSON dos anexos e imagens vinculados via Google Drive ou URL"
        },
        "remindersJson": {
          "type": "string",
          "minLength": 0,
          "maxLength": 2000,
          "description": "JSON das múltiplas notificações (popup/email) do evento"
        },
        "pendingGoogleSync": {
          "type": "boolean",
          "description": "Indica que há alterações locais aguardando envio ao Google Calendar pelo administrador"
        },
        "createdByUid": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$",
          "description": "UID do usuário criador"
        },
        "createdByName": {
          "type": "string",
          "minLength": 1,
          "maxLength": 80,
          "description": "Nome de exibição do usuário criador"
        },
        "updatedByUid": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$",
          "description": "UID do último usuário que alterou a atividade"
        },
        "updatedByName": {
          "type": "string",
          "minLength": 1,
          "maxLength": 80,
          "description": "Nome de exibição do último usuário que alterou"
        },
        "createdAt": {
          "type": "string",
          "format": "date-time",
          "description": "Carimbo de criação no servidor"
        },
        "updatedAt": {
          "type": "string",
          "format": "date-time",
          "description": "Carimbo da última atualização no servidor"
        }
      },
      "required": [
        "id",
        "title",
        "category",
        "status",
        "startAt",
        "endAt",
        "allDay",
        "location",
        "responsibles",
        "description",
        "reminderMinutes",
        "sectionScope",
        "googleEventId",
        "googleCalendarId",
        "googleCalendarSummary",
        "googleHtmlLink",
        "syncStatus",
        "lastSyncedAt",
        "createdByUid",
        "createdByName",
        "updatedByUid",
        "updatedByName",
        "createdAt",
        "updatedAt"
      ]
    },
    "AgendaAuditLog": {
      "title": "AgendaAuditLog",
      "description": "Registro imutável de auditoria das ações realizadas na Agenda da Comunicação Social e na sincronização com o Google Calendar.",
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$",
          "description": "Identificador único do registro de auditoria"
        },
        "eventId": {
          "type": "string",
          "minLength": 0,
          "maxLength": 128,
          "pattern": "^$|^[a-zA-Z0-9_\\-]+$",
          "description": "ID do evento relacionado, quando aplicável"
        },
        "action": {
          "type": "string",
          "enum": [
            "create",
            "update",
            "delete",
            "sync_push",
            "sync_update",
            "sync_delete",
            "google_connect",
            "google_disconnect"
          ],
          "description": "Tipo de ação registrada"
        },
        "summary": {
          "type": "string",
          "minLength": 1,
          "maxLength": 240,
          "description": "Descrição resumida da operação"
        },
        "actorUid": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$",
          "description": "UID do usuário que executou a ação"
        },
        "actorName": {
          "type": "string",
          "minLength": 1,
          "maxLength": 80,
          "description": "Nome de exibição do usuário"
        },
        "sectionScope": {
          "type": "string",
          "enum": ["comsoc"],
          "description": "Escopo institucional da seção"
        },
        "createdAt": {
          "type": "string",
          "format": "date-time",
          "description": "Carimbo de data/hora no servidor"
        }
      },
      "required": [
        "id",
        "eventId",
        "action",
        "summary",
        "actorUid",
        "actorName",
        "sectionScope",
        "createdAt"
      ]
    },
    "AgendaIntegrationConfig": {
      "title": "AgendaIntegrationConfig",
      "description": "Configuração institucional gerenciada exclusivamente por administradores indicando o calendário Google vinculado da COMSOC e sugestões de contatos em cache (nunca armazena tokens).",
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "enum": ["google_calendar"],
          "description": "Identificador fixo da configuração"
        },
        "selectedCalendarId": {
          "type": "string",
          "minLength": 0,
          "maxLength": 256,
          "description": "ID do calendário escolhido no Google Calendar"
        },
        "selectedCalendarSummary": {
          "type": "string",
          "minLength": 0,
          "maxLength": 140,
          "description": "Nome de exibição do calendário vinculado"
        },
        "lockedAccountEmail": {
          "type": "string",
          "minLength": 0,
          "maxLength": 140,
          "description": "E-mail institucional Google associado à Agenda do SISCOM"
        },
        "lastSyncAt": {
          "type": "string",
          "minLength": 0,
          "maxLength": 40,
          "description": "Data/hora ISO da última sincronização geral realizada pelo administrador"
        },
        "contactsCacheJson": {
          "type": "string",
          "minLength": 0,
          "maxLength": 60000,
          "description": "Cache JSON de sugestões de contatos (nome e e-mail) para autocompletar convidados"
        },
        "updatedByUid": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$",
          "description": "UID do administrador que atualizou a configuração"
        },
        "updatedByName": {
          "type": "string",
          "minLength": 1,
          "maxLength": 80,
          "description": "Nome de exibição do administrador"
        },
        "updatedAt": {
          "type": "string",
          "format": "date-time",
          "description": "Carimbo de atualização no servidor"
        }
      },
      "required": [
        "id",
        "selectedCalendarId",
        "selectedCalendarSummary",
        "updatedByUid",
        "updatedByName",
        "updatedAt"
      ]
    }
  },
  "firestore": {
    "/admins/{userId}": {
      "schema": { "$ref": "#/entities/AdminMarker" },
      "description": "Documentos marcadores de administradores autorizados"
    },
